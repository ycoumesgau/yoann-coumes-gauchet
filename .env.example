# Copy to .env for local development. Production values live in Vercel only.
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/site
PAYLOAD_SECRET=change-me-to-a-long-random-string

# MCP server (ADR-2). Closed (503) unless all three are set.
# ENABLE_MCP=true
# SITE_URL=http://localhost:3000
# A private EC P-256 JWK with a `kid`, on one line. Generated straight into Vercel, never shown:
#   node -e 'require("jose").generateKeyPair("ES256",{extractable:true}).then(async k=>process.stdout.write(JSON.stringify({...await require("jose").exportJWK(k.privateKey),kid:"site-1"})))' | vercel env add MCP_OAUTH_SIGNING_KEY production
# Locally, replace the pipe with `>> .env` and prefix the line with MCP_OAUTH_SIGNING_KEY=.
# MCP_OAUTH_SIGNING_KEY=
